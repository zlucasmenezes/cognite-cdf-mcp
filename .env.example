# Cognite Data Fusion — default profile (session starts on "default")
CDF_PROJECT=your-project
CDF_CLUSTER=westeurope-1

# Auth flow: client_credentials (default) | token
# CDF_LOGIN_FLOW=client_credentials

# --- client_credentials (global; shared by all environments) ---
IDP_TENANT_ID=00000000-0000-0000-0000-000000000000
IDP_CLIENT_ID=your-client-id
IDP_CLIENT_SECRET=your-client-secret

# --- token (set CDF_LOGIN_FLOW=token) ---
# CDF_LOGIN_FLOW=token
# CDF_TOKEN=eyJ...

# --- Optional named environments (flat vars; alias = suffix, case-insensitive) ---
# An alias exists iff CDF_PROJECT_<ALIAS> is set. "default" is reserved for CDF_PROJECT.
# CDF_PROJECT_DEV=your-dev-project
# CDF_PROJECT_QA=your-qa-project
# CDF_PROJECT_PROD=your-prod-project
#
# Optional per-alias overrides (omit -> inherit CDF_CLUSTER / CDF_TOKEN):
# CDF_CLUSTER_PROD=other-cluster
# CDF_TOKEN_PROD=eyJ-only-if-different
